|HEADER=Protel for Windows - PCB ASCII File Version 5.0|

[Board]
Version=6.0
BoardThickness=1.6mm
BoardMaterial=FR-4
CopperWeight=1oz
BoardOutline.X1=0mm
BoardOutline.Y1=0mm
BoardOutline.X2=120mm
BoardOutline.Y2=60mm
LayerCount=2
TopLayer=Top
BottomLayer=Bottom
Finish=HASL
SolderMaskColor=Green
SilkscreenColor=White

[LayerStack]
Layer1=TopOverlay|Silk
Layer2=TopPaste|Paste
Layer3=TopSolder|SolderMask
Layer4=Top|Signal|35um
Layer5=Dielectric|Core|1.5mm|FR-4|Er=4.5
Layer6=Bottom|Signal|35um
Layer7=BottomSolder|SolderMask
Layer8=BottomPaste|Paste
Layer9=BottomOverlay|Silk

[Design Rules]
; Safety clearances for 230VAC mains
MinClearance_MainsToLogic=8mm
MinClearance_MainsToMains=3.5mm
MinClearance_Default=0.2mm
MinTraceWidth_Mains=3.5mm
MinTraceWidth_Power=1mm
MinTraceWidth_Signal=0.25mm
DefaultViaSize=0.8mm
DefaultViaHole=0.4mm
ThermalReliefWidth=0.3mm
ThermalReliefGap=0.25mm

[Board Zones]
; Logic zone (MCU header, optocouplers, low voltage)
Zone1=LogicZone|X1=0mm|Y1=0mm|X2=35mm|Y2=60mm|NetClass=Logic
; Isolation zone (DC-DC, ULN2803, isolated ground)
Zone2=IsolationZone|X1=35mm|Y1=0mm|X2=50mm|Y2=60mm|NetClass=Isolated
; Mains zone (relays, fuses, terminals, MOV)
Zone3=MainsZone|X1=50mm|Y1=0mm|X2=120mm|Y2=60mm|NetClass=Mains

[Keepout/Slot]
; Milled slot between logic and mains for increased creepage
; Design Rule: SLOT_ISOLATION - Maintains 8mm+ creepage requirement
; If board size changes, adjust slot position to maintain isolation zones
Slot1.Type=RoutedSlot
Slot1.X1=48mm
Slot1.Y1=5mm
Slot1.X2=48mm
Slot1.Y2=55mm
Slot1.Width=2mm
Slot1.Layer=MultiLayer
Slot1.Note=Creepage isolation slot between logic and mains
Slot1.DesignRule=SLOT_ISOLATION_BARRIER

