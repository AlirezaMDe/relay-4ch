[Design Rules]
; Safety clearances for 230VAC (IEC 60335-1, Pollution Degree 2)
Rule1=MinClearance_MainsToLogic=8mm
Rule2=MinClearance_MainsToMains=3.5mm
Rule3=MinTraceWidth_Mains=3.5mm
Rule4=MinTraceWidth_Power=1mm
Rule5=MinTraceWidth_Signal=0.25mm
Rule6=ViaDiameter=0.8mm
Rule7=ViaHole=0.4mm

